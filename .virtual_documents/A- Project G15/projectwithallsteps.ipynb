        )
        ecr_bau = np.zeros((len(model.data_loader.REGION_LIST), len(model.time_horizon.model_time_horizon)))
        model.run(emission_control_rate=ecr_bau, endogenous_savings_rate=True)
        data = model.evaluate()
        results_wf[wf_name] = data["welfare"]

    results_wf
else:
